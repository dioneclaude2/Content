{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/nancy-socials/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://dioneclaude2.github.io"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/alerts?kind=daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/alerts?kind=weekly",
      "schedule": "30 0 * * 1"
    }
  ]
}
